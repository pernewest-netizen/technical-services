{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "copyFile": true,
        "createDir": true,
        "removeDir": true,
        "removeFile": true,
        "renameFile": true,
        "exists": true,
        "scope": [
          "$APPLOCALDATA/**",
          "$DESKTOP/**",
          "D:/**",
          "C:/**"
        ]
      },
      "path": {
        "all": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "shell": {
        "all": false,
        "open": true,
        "scope": [
          {
            "name": "explorer",
            "cmd": "explorer",
            "args": true
          },
          {
            "name": "photoshop",
            "cmd": "photoshop",
            "args": true
          }
        ]
      },
      "os": {
        "all": true
      },
      "process": {
        "relaunch": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "Technical Services",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ],
      "identifier": "com.technicalservices.app",
      "longDescription": "Technical Services - Design & Production Management System",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "Technical Services",
      "targets": [
        "nsis",
        "msi"
      ],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "webviewInstallMode": {
          "type": "offlineInstaller",
          "silent": true
        },
        "allowDowngrades": false,
        "nsis": {
          "installMode": "currentUser",
          "displayLanguageSelector": false,
          "languages": [
            "Arabic",
            "English"
          ],
          "shortcutName": "المعاونة الفنية",
          "startMenuFolder": "المعاونة الفنية"
        }
      },
      "publisher": "Technical Services"
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "المعاونة الفنية | Technical Services",
        "width": 1440,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ]
  },
  "package": {
    "productName": "المعاونة الفنية",
    "version": "1.0.0"
  }
}
